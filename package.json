{
  "name": "ai-friendly-lightweight-travel-template",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "boundaries:sync": "node scripts/sync-boundaries.mjs",
    "boundaries:index": "node scripts/build-boundary-index.mjs",
    "boundaries:validate": "node scripts/validate-boundaries.mjs",
    "build:map": "node scripts/build-map.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "deploy:pages": "npm run build:pages && npx wrangler pages deploy dist --project-name travel-plan-private",
    "initialize:public-trip": "node scripts/initialize-public-trip.mjs",
    "validate": "node scripts/validate-lite.mjs",
    "test:runtime": "node --test tests/runtime/*.test.cjs",
    "preview": "node local-preview-server.mjs"
  }
}
